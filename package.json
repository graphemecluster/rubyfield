{
	"name": "rubyfield-workspace",
	"private": true,
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"build": "bun run --filter rubyfield build && bun run --filter @rubyfield/react build && bun run --filter @rubyfield/vue build && bun run --filter @rubyfield/demo build",
		"dev": "bun run --filter @rubyfield/demo dev",
		"typecheck": "tsc --noEmit",
		"format": "dprint fmt",
		"format:check": "dprint check --list-different",
		"test": "bun test tests",
		"test:browser": "bun test tests/browser.test.ts"
	},
	"devDependencies": {
		"@tiptap/pm": "3.35.0",
		"@types/bun": "^1.4.5",
		"@types/kuromoji": "^0.1.3",
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"dprint": "^0.65.0",
		"jsr": "^0.14.3",
		"playwright-core": "^1.65.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vue": "^3.5.46"
	},
	"packageManager": "bun@1.4.4"
}
